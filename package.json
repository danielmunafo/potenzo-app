{
  "name": "potenzo-app",
  "main": "expo-router/entry",
  "version": "0.1.2",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ]
  },
  "scripts": {
    "start": "expo start",
    "start:local-device": "npx expo start --dev-client --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "build:preview": "npx expo prebuild --clean && eas build --profile preview --local",
    "android": "expo run:android",
    "android:dev-client": "eas build --profile development --platform android --local",
    "android:clean": "rm -rf android/app/build && expo run:android",
    "ios": "expo run:ios",
    "ios:dev-client": "eas build --profile development --platform ios --local",
    "ios:clean": "rm -rf ios/build && expo run:ios",
    "web": "expo start --web",
    "release": "standard-version",
    "commit": "git-cz",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:e2e": "maestro test .maestro/",
    "clean": "rm -rf android/app/build ios/build"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.4.13",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native/metro-config": "^0.80.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@sentry/react-native": "~6.14.0",
    "dotenv": "^16.5.0",
    "expo": "53.0.13",
    "expo-blur": "~14.1.5",
    "expo-constants": "~17.1.6",
    "expo-dev-client": "~5.2.2",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.3.0",
    "expo-linking": "~7.1.5",
    "expo-localization": "^16.1.5",
    "expo-router": "~5.1.1",
    "expo-splash-screen": "~0.30.9",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.9",
    "expo-updates": "~0.28.15",
    "expo-web-browser": "~14.2.0",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^15.5.3",
    "react-native": "0.79.4",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-pager-view": "6.7.1",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-reanimated-carousel": "^4.0.2",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-video": "^6.16.0",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@spotlightjs/spotlight": "^3.0.1",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.0.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.7",
    "prettier": "^3.6.1",
    "semantic-release": "^24.2.5",
    "standard-version": "^9.5.0",
    "typescript": "~5.8.3"
  },
  "private": true
}
